# demo: 설정이 있어도 운영 DB/AI에 연결하지 않음
# auto: Supabase 설정이 있으면 운영 모드, 없으면 기존 Demo Mode
APP_MODE=auto
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Phase 2B 작업 완료·편집 RPC 전용 서버 키. 사용자 권한은 각 RPC에서 다시 검사합니다.
# 실제 값은 .env.local / 배포 환경 보안 설정에만 보관. NEXT_PUBLIC_ 접두사 금지.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# 후보 모델. 자신의 API 계정에서 접근/Structured Outputs 지원을 실제 검증해야 합니다.
# DB ai_policy.model과 정확히 일치해야 하며, 정책 enabled는 기본 false입니다.
OPENAI_MODEL=gpt-4.1-mini

# Gemini alternative: AI_PROVIDER=gemini, OPENAI_MODEL=gemini-2.5-flash
# OPENAI_MODEL remains the existing shared model selector and must match ai_policy.model
# Never place this secret in a NEXT_PUBLIC_ environment variable.
AI_PROVIDER=openai
GEMINI_API_KEY=
